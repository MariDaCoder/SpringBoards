# ==============================================================================
# Springboards Repository (springboards) — Complete Environment Variables
# Discovered across firebase-applet-config.json, firebase.json, .firebaserc,
# src/config/env.js, src/lib/firebase-admin.js, src/db/index.ts & workspace-sheets.js
# ==============================================================================

# 1. Server & Canonical Domain Configuration (Node >=20.0.0 LTS runtime in package.json)
# Note: In apphosting.yaml, NODE_ENV=production is scoped to RUNTIME only so `npm ci` installs devDependencies during BUILD.
PORT=3000
NODE_ENV=production
APP_URL=https://springboardsfcd.org
ALLOWED_ORIGINS=https://springboardsfcd.org,https://www.springboardsfcd.org,https://springboards-backend--springboards-community-dev.us-east4.hosted.app,https://springboards-community-dev.web.app,https://springboards-community-dev.firebaseapp.com,https://ais-dev-qnd7dwpxy5lvvqlhyhakyp-11235862349.us-west2.run.app,https://ais-pre-qnd7dwpxy5lvvqlhyhakyp-11235862349.us-west2.run.app

