        "type": 301
      },
      {
        "source": "/legal",
        "destination": "/utility/privacy-terms",
        "type": 301
      },
      {
        "source": "/privacy-terms",
        "destination": "/utility/privacy-terms",
        "type": 301
      },
      {
        "source": "/utility/privacy-terms/index.html",
        "destination": "/utility/privacy-terms",
