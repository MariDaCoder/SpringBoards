      },
      {
        "source": "/style-guide",
        "destination": "/resources/style-guide",
        "type": 301
      },
      {
        "source": "/style-guide.html",
        "destination": "/resources/style-guide",
        "type": 301
      },
      {
        "source": "/resources/style-guide/index.html",
        "destination": "/resources/style-guide",
        "type": 301
      },
      {
        "source": "/backoffice",
        "destination": "/resources/backoffice",
        "type": 301
      },
      {
        "source": "/backoffice.html",
        "destination": "/resources/backoffice",
        "type": 301
      },
      {
        "source": "/resources/backoffice/index.html",
        "destination": "/resources/backoffice",
        "type": 301
      },
      {
        "source": "/portal",
        "destination": "/resources/backoffice",
        "type": 301
      },
      {
        "source": "/cms-workflows",
        "destination": "/resources/cms-workflows",
