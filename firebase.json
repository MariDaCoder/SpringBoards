{
  "hosting": {
    "site": "springboards-community-dev",
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "server.js",
      "backoffice-data.json",
      "package.json",
      "package-lock.json",
      "bun.lock",
      "**/.*",
      "!/.well-known/**",
      "**/node_modules/**",
      "src/**",
      "scripts/**",
      "backup/**",
      "program-readiness/**",
      "reference_documents"
    ],
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/programs",
