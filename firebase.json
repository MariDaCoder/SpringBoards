{
  "hosting": {
    "site": "springboards-community-dev",
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "server.js",
      "backoffice-data.json",
      "package.json",
      "package-lock.json",
      "bun.lock",
      "**/.*",
      "**/node_modules/**",
      "src/**",
      "scripts/**",
      "backup/**",
      "program-readiness/**",
      "reference_documents"
    ],
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/programs",
        "destination": "/programs/train",
        "type": 301
      },
      {
        "source": "/train",
        "destination": "/programs/train",
        "type": 301
      },
      {
        "source": "/train.html",
        "destination": "/programs/train",
        "type": 301
      },
      {
        "source": "/programs/train/index.html",
        "destination": "/programs/train",
        "type": 301
      },
      {
        "source": "/eligibility",
        "destination": "/programs/eligibility",
        "type": 301
      },
      {
        "source": "/eligibility.html",
        "destination": "/programs/eligibility",
        "type": 301
      },
      {
        "source": "/programs/eligibility/index.html",
        "destination": "/programs/eligibility",
        "type": 301
      },
      {
        "source": "/community",
        "destination": "/community/volunteer",
        "type": 301
      },
      {
        "source": "/volunteer",
        "destination": "/community/volunteer",
        "type": 301
      },
      {
        "source": "/volunteer.html",
        "destination": "/community/volunteer",
        "type": 301
      },
      {
        "source": "/community/volunteer/index.html",
        "destination": "/community/volunteer",
        "type": 301
      },
      {
        "source": "/partner",
        "destination": "/community/partner",
        "type": 301
      },
      {
        "source": "/partner.html",
        "destination": "/community/partner",
        "type": 301
      },
      {
        "source": "/community/partner/index.html",
        "destination": "/community/partner",
        "type": 301
      },
      {
        "source": "/donate",
        "destination": "/community/donate",
        "type": 301
      },
      {
        "source": "/donate.html",
        "destination": "/community/donate",
        "type": 301
      },
      {
        "source": "/community/donate/index.html",
        "destination": "/community/donate",
        "type": 301
      },
      {
        "source": "/resources",
        "destination": "/resources/style-guide",
        "type": 301
      },
      {
        "source": "/style-guide",
        "destination": "/resources/style-guide",
        "type": 301
      },
      {
        "source": "/style-guide.html",
        "destination": "/resources/style-guide",
        "type": 301
      },
      {
        "source": "/resources/style-guide/index.html",
        "destination": "/resources/style-guide",
        "type": 301
      },
      {
        "source": "/backoffice",
        "destination": "/resources/backoffice",
        "type": 301
      },
      {
        "source": "/backoffice.html",
        "destination": "/resources/backoffice",
        "type": 301
      },
      {
        "source": "/resources/backoffice/index.html",
        "destination": "/resources/backoffice",
        "type": 301
      },
      {
        "source": "/portal",
        "destination": "/resources/backoffice",
        "type": 301
      },
      {
        "source": "/cms-workflows",
        "destination": "/resources/cms-workflows",
        "type": 301
      },
      {
        "source": "/cms-workflows.html",
        "destination": "/resources/cms-workflows",
        "type": 301
      },
      {
        "source": "/resources/cms-workflows/index.html",
        "destination": "/resources/cms-workflows",
        "type": 301
      },
      {
        "source": "/utility",
        "destination": "/utility/search",
        "type": 301
      },
      {
        "source": "/search",
        "destination": "/utility/search",
        "type": 301
      },
      {
        "source": "/search.html",
        "destination": "/utility/search",
        "type": 301
      },
      {
        "source": "/utility/search/index.html",
        "destination": "/utility/search",
        "type": 301
      },
      {
        "source": "/password",
        "destination": "/utility/password",
        "type": 301
      },
      {
        "source": "/password.html",
        "destination": "/utility/password",
        "type": 301
      },
      {
        "source": "/401",
        "destination": "/utility/password",
        "type": 301
      },
      {
        "source": "/utility/password/index.html",
        "destination": "/utility/password",
        "type": 301
      },
      {
        "source": "/privacy",
        "destination": "/utility/privacy-terms",
        "type": 301
      },
      {
        "source": "/terms",
        "destination": "/utility/privacy-terms",
        "type": 301
      },
      {
        "source": "/legal",
        "destination": "/utility/privacy-terms",
        "type": 301
      },
      {
        "source": "/privacy-terms",
        "destination": "/utility/privacy-terms",
        "type": 301
      },
      {
        "source": "/utility/privacy-terms/index.html",
        "destination": "/utility/privacy-terms",
        "type": 301
      },
      {
        "source": "/pathways",
        "destination": "/programs/pathways",
        "type": 301
      },
      {
        "source": "/programs/pathways/index.html",
        "destination": "/programs/pathways",
        "type": 301
      },
      {
        "source": "/career-centers/**",
        "destination": "/programs/eligibility",
        "type": 301
      },
      {
        "source": "/partners/**",
        "destination": "/community/partner",
        "type": 301
      },
      {
        "source": "/faq/**",
        "destination": "/programs/train",
        "type": 301
      },
      {
        "source": "/utility-pages/**",
        "destination": "/resources/cms-workflows",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/programs/pathways/**",
        "destination": "/programs/pathways/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(webp|jpg|jpeg|png|svg|ico|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, stale-while-revalidate=86400"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Timing-Allow-Origin",
            "value": "*"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "/assets/cms/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, stale-while-revalidate=3600"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  },
  "firestore": {
    "database": "main",
    "location": "us-east1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}