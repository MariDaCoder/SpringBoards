        "destination": "/programs/pathways",
        "type": 301
      },
      {
        "source": "/programs/pathways/index.html",
        "destination": "/programs/pathways",
        "type": 301
      },
      {
        "source": "/programs/pathways/hvac-mechanical-systems",
        "destination": "/programs/pathways/hvac-mechanical",
