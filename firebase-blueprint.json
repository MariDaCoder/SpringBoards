{
  "entities": {
    "ProgramInquiry": {
      "title": "ProgramInquiry",
      "description": "Public inquiry about Springboards training pathways",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "program": { "type": "string" },
        "tag": { "type": "string" },
        "deliveredTo": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "program", "createdAt"]
    },
    "CandidateApplication": {
      "title": "CandidateApplication",
      "description": "Candidate intake application for trade training and transitional jobs",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "trade": { "type": "string" },
        "backgroundStatus": { "type": "string" },
        "transportation": { "type": "string" },
        "careerCenter": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "trade", "createdAt"]
    },
    "VolunteerSignup": {
      "title": "VolunteerSignup",
      "description": "Community volunteer interest registration",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "availability": { "type": "string" },
        "interest": { "type": "string" },
        "location": { "type": "string" },
        "event": { "type": "string" },
        "deliveredTo": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "availability", "interest", "createdAt"]
    },
    "RoadmapProgress": {
      "title": "RoadmapProgress",
      "description": "Participant journey roadmap milestone tracking and Classroom course sync",
      "type": "object",
      "properties": {
        "completedSteps": { "type": "array", "items": { "type": "number" } },
        "currentStep": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["currentStep", "updatedAt"]
    },
    "EmployerPartnership": {
      "title": "EmployerPartnership",
      "description": "Employer worksite and trade resource partnership submission",
      "type": "object",
      "properties": {
        "companyName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "contactName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 120 },
        "partnershipType": { "type": "string", "maxLength": 120 },
        "tradeSpecialty": { "type": "string", "maxLength": 120 },
        "message": { "type": "string", "maxLength": 1500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyName", "contactName", "createdAt"]
    },
    "DonationPledge": {
      "title": "DonationPledge",
      "description": "Community donor sponsorship or equipment pledge record",
      "type": "object",
      "properties": {
        "donorName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 120 },
        "donationType": { "type": "string", "maxLength": 100 },
        "pledgeAmount": { "type": "string", "maxLength": 150 },
        "taxReceiptRequested": { "type": "boolean" },
        "message": { "type": "string", "maxLength": 1500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["donorName", "createdAt"]
    },
    "TeamRoleAssignment": {
      "title": "TeamRoleAssignment",
      "description": "Custom RBAC role assignment and granular permissions for Springboards team and board members",
      "type": "object",
      "properties": {
        "memberId": { "type": "string", "minLength": 2, "maxLength": 80 },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "roleId": { "type": "string", "minLength": 2, "maxLength": 100 },
        "approvalAuthority": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["memberId", "name", "roleId", "updatedAt"]
    },
    "PublishingWorkflow": {
      "title": "PublishingWorkflow",
      "description": "4-stage website design, content, compliance review, and production publishing workflow request",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 180 },
        "targetRoute": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "type": "string", "maxLength": 100 },
        "authorName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "currentStage": { "type": "string", "enum": ["stage_1_draft", "stage_2_domain_compliance_review", "stage_3_executive_board_approval", "stage_4_published"] },
        "driveEvidenceDoc": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "targetRoute", "authorName", "currentStage", "updatedAt"]
    }
  },
  "firestore": {
    "/programInquiries/{docId}": {
      "schema": { "$ref": "#/entities/ProgramInquiry" },
      "description": "Public program inquiries"
    },
    "/candidateApplications/{docId}": {
      "schema": { "$ref": "#/entities/CandidateApplication" },
      "description": "Candidate training applications"
    },
    "/volunteerSignups/{docId}": {
      "schema": { "$ref": "#/entities/VolunteerSignup" },
      "description": "Volunteer signups"
    },
    "/employerPartnerships/{docId}": {
      "schema": { "$ref": "#/entities/EmployerPartnership" },
      "description": "Employer and resource partnership inquiries"
    },
    "/donationPledges/{docId}": {
      "schema": { "$ref": "#/entities/DonationPledge" },
      "description": "Community donation pledges and receipt requests"
    },
    "/roadmapProgress/{userId}": {
      "schema": { "$ref": "#/entities/RoadmapProgress" },
      "description": "User progress along the custom participant journey roadmap"
    },
    "/teamRoles/{memberId}": {
      "schema": { "$ref": "#/entities/TeamRoleAssignment" },
      "description": "Custom team role assignments and granular access controls"
    },
    "/publishingWorkflows/{workflowId}": {
      "schema": { "$ref": "#/entities/PublishingWorkflow" },
      "description": "4-stage website review, approval, and publishing workflow items"
    }
  }
}

